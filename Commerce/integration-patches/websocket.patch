diff --git a/Server/GWS_SessionBinding.php b/Server/GWS_SessionBinding.php
new file mode 100644
index 0000000..7ab340b
--- /dev/null
+++ b/Server/GWS_SessionBinding.php
@@ -0,0 +1,19 @@
+<?php
+declare(strict_types=1);
+namespace GDO\Websocket\Server;
+/** Per-connection immutable authentication snapshot, never stored on a user. */
+final class GWS_SessionBinding
+{
+    public static function snapshot(array $row): array {
+        foreach(['sess_id','sess_token','sess_auth'] as $key)if(!is_string($row[$key]??null)||$row[$key]==='')throw new \RuntimeException('Session unavailable',403);
+        return array_intersect_key($row,array_flip(['sess_id','sess_token','sess_auth','sess_user']));
+    }
+    public static function verify(array $binding,?array $session,?array $user,int $maxAge=0): void {
+        if(!$session)throw new \RuntimeException('Session revoked',403);
+        foreach(['sess_id','sess_token','sess_auth','sess_user'] as $key){
+            if(!array_key_exists($key,$session)||!array_key_exists($key,$binding)||$binding[$key]!==$session[$key])throw new \RuntimeException('Session revoked',403);
+        }
+        if($maxAge>0){$time=strtotime(($session['sess_time']??'').' UTC');if($time===false||$time<time()-$maxAge)throw new \RuntimeException('Session expired',403);}
+        if($session['sess_user']!==null && (!$user||!array_key_exists('user_deleted',$user)||(string)$user['user_id']!==$session['sess_user']||($user['user_deleted']??null)!==null))throw new \RuntimeException('Account unavailable',403);
+    }
+}
